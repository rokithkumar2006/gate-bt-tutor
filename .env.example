# AI Tutor — OpenAI-compatible LLM backend.
# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
#
# The tutor works with NO key at all (deterministic syllabus engine).
# Setting a key upgrades free-form answers to a real LLM, with automatic
# fallback to the deterministic engine on any error.

GATE_BT_LLM_API_KEY=
# Blackbox:  https://api.blackbox.ai       model e.g. blackboxai/openai/gpt-4o-mini
# OpenAI:    https://api.openai.com/v1     model e.g. gpt-4o-mini
# Groq:      https://api.groq.com/openai/v1
# OpenRouter:https://openrouter.ai/api/v1
GATE_BT_LLM_BASE_URL=https://api.blackbox.ai
GATE_BT_LLM_MODEL=blackboxai/openai/gpt-4o-mini

# Set to 1 when serving the app over HTTPS inside a cross-site iframe
# (e.g. the sandbox preview at https://<port>-<id>.e2b.app). Issues the
# session cookie as SameSite=None; Secure so the browser sends it back.
GATE_BT_CROSS_SITE_COOKIE=0

# ---------------------------------------------------------------------------
# Supabase (optional). Set BOTH to store data in Postgres instead of the local
# data/db.json file. Without them the app falls back to the JSON file store, so
# a fresh clone runs with zero configuration.
#
# Find these in: Supabase dashboard -> Project Settings -> API
#   SUPABASE_URL              = Project URL      (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = service_role key (SECRET — server-side only,
#                               never prefix with NEXT_PUBLIC_)
# Run db/supabase-schema.sql in the SQL Editor first to create the tables.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
